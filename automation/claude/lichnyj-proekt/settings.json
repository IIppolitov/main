{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git restore .)",
      "Bash(git restore .:*)",
      "Bash(git restore -W:*)",
      "Bash(git restore --worktree:*)",
      "Bash(git checkout -f:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git rm:*)",
      "Bash(git commit -a)",
      "Bash(git commit -a:*)",
      "Bash(git commit -am:*)",
      "Bash(git commit --all:*)",
      "Bash(git add -A)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(git filter-branch:*)",
      "Bash(git reflog delete:*)",
      "Bash(git reflog expire:*)",
      "Bash(rm -rf:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh auth login:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh auth token:*)",
      "Bash(sqlcmd:*)",
      "Bash(bcp:*)",
      "Bash(osql:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git config:*)",
      "Bash(gh repo create:*)",
      "Bash(automation/scripts/tracker-create.py:*)",
      "Bash(./automation/scripts/tracker-create.py:*)",
      "Bash(automation/scripts/tracker-update.py:*)",
      "Bash(./automation/scripts/tracker-update.py:*)",
      "Bash(automation/scripts/wiki-push.py:*)",
      "Bash(./automation/scripts/wiki-push.py:*)",
      "Bash(curl:*)"
    ],
    "allow": [
      "Bash(automation/scripts/tracker-issue.sh:*)",
      "Bash(bash automation/scripts/tracker-issue.sh:*)",
      "Bash(automation/scripts/wiki-page.sh:*)",
      "Bash(bash automation/scripts/wiki-page.sh:*)",
      "Bash(automation/scripts/wiki2md.py:*)",
      "Bash(automation/scripts/md2rtf.py:*)",
      "Bash(automation/scripts/check-links.py:*)",
      "Bash(date:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git remote:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(gh auth status:*)",
      "Bash(gh repo view:*)"
    ]
  }
}
