{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git merge:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git reflog delete:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc:*)",
      "Bash(git prune:*)",
      "Bash(git config:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --force:*)",
      "Bash(git -C:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --work-tree:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(sqlcmd:*)",
      "Bash(/opt/mssql-tools18/bin/sqlcmd:*)",
      "Bash(/opt/mssql-tools/bin/sqlcmd:*)",
      "Bash(bcp:*)",
      "Bash(osql:*)",
      "Bash(isql:*)",
      "Bash(superset:*)",
      "Edit(../pbeadmin/**)",
      "Edit(../pbeapp/**)",
      "Edit(../pbeconsole/**)",
      "Write(../pbeadmin/**)",
      "Write(../pbeapp/**)",
      "Write(../pbeconsole/**)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(.claude/scripts/superset-api.sh --import:*)",
      "Bash(./.claude/scripts/superset-api.sh --import:*)"
    ],
    "allow": [
      "Bash(.claude/scripts/db-query.sh:*)",
      "Bash(./.claude/scripts/db-query.sh:*)",
      "Bash(.claude/scripts/superset-api.sh --whoami:*)",
      "Bash(.claude/scripts/superset-api.sh --profiles:*)",
      "Bash(.claude/scripts/superset-api.sh --list:*)",
      "Bash(.claude/scripts/superset-api.sh --get:*)",
      "Bash(.claude/scripts/superset-api.sh --export:*)",
      "Bash(./.claude/scripts/superset-api.sh --whoami:*)",
      "Bash(./.claude/scripts/superset-api.sh --profiles:*)",
      "Bash(./.claude/scripts/superset-api.sh --list:*)",
      "Bash(./.claude/scripts/superset-api.sh --get:*)",
      "Bash(./.claude/scripts/superset-api.sh --export:*)",
      "Bash(.claude/scripts/tracker-issue.sh:*)",
      "Bash(./.claude/scripts/tracker-issue.sh:*)",
      "Bash(.claude/scripts/wiki-page.sh:*)",
      "Bash(./.claude/scripts/wiki-page.sh:*)",
      "Bash(.claude/scripts/wiki2md.py:*)",
      "Bash(./.claude/scripts/wiki2md.py:*)",
      "Bash(.claude/scripts/client-env.sh:*)",
      "Bash(./.claude/scripts/client-env.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(git ls-files:*)"
    ]
  }
}
