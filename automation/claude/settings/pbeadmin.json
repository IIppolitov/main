      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(php artisan db:seed:*)",
      "Bash(php artisan queue:flush:*)",
      "Bash(php artisan queue:forget:*)",
      "Bash(php artisan tinker:*)",
      "Bash(composer update:*)",
      "Bash(npm install:*)",
      "Bash(npm update:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(sqlcmd:*)",
      "Bash(/opt/mssql-tools18/bin/sqlcmd:*)",
      "Bash(/opt/mssql-tools/bin/sqlcmd:*)",
      "Bash(bcp:*)",
      "Bash(osql:*)",
      "Bash(isql:*)"
    ],
    "ask": [
      "Bash(git -C:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --work-tree:*)",
      "Bash(git submodule update:*)",
      "Bash(rm:*)",
      "Bash(php artisan migrate:*)",
      "Bash(php artisan migrate)",
      "Bash(php artisan queue:work:*)",
      "Bash(php artisan schedule:run:*)",
      "Bash(vendor/bin/phpunit)",
      "Bash(php artisan test:*)",
      "Bash(composer install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run prod:*)"
    ],
    "allow": [
      "Bash(php -l:*)",
      "Bash(vendor/bin/phpunit --testsuite Unit:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan module:list:*)",
      "Bash(php artisan l5-swagger:generate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch --list:*)",
      "Bash(git submodule status:*)",
      "Bash(git ls-files:*)",
      "Bash(.claude/scripts/db-query.sh:*)",
      "Bash(bash .claude/scripts/db-query.sh:*)",
      "Bash(./.claude/scripts/db-query.sh:*)"
    ]
