{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git stage:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git clean:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -m:*)",
      "Bash(git branch -M:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch --move:*)",
      "Bash(git branch --force:*)",
      "Bash(git submodule foreach:*)",
      "Bash(git submodule add:*)",
      "Bash(git submodule sync:*)",
      "Bash(git submodule deinit:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git worktree:*)",
      "Bash(git bisect:*)",
      "Bash(git update-index:*)",
      "Bash(git update-ref:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git filter-branch:*)",
      "Bash(git reflog delete:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc:*)",
      "Bash(git prune:*)",
      "Bash(git config:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(./make-pre-prod-release.sh:*)",
      "Bash(./make-pre-prod-fix.sh:*)",
      "Bash(./make-prod-hotfix.sh:*)",
      "Bash(./checkout-prod.sh:*)",
      "Bash(bash make-pre-prod-release.sh:*)",
      "Bash(bash make-pre-prod-fix.sh:*)",
      "Bash(bash make-prod-hotfix.sh:*)",
      "Bash(bash checkout-prod.sh:*)",
      "Bash(php artisan migrate:fresh:*)",
